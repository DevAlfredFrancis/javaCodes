<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="500.0" prefWidth="500.0" spacing="10" style="-fx-padding: 20; -fx-background-color: #393D40;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.luxeauraapp.controllers.EditServiceController">
   <AnchorPane prefHeight="440.0" prefWidth="460.0">
      <children>
         <Text fill="WHITE" layoutX="25.0" layoutY="25.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Edit Salon Service">
            <font>
               <Font name="Barlow Condensed Medium" size="22.0" />
            </font>
         </Text>
      
          <TextField fx:id="serviceNameField" layoutX="23.0" layoutY="76.0" prefHeight="34.0" prefWidth="415.0" promptText="Service Name" />
          <TextField fx:id="durationField" layoutX="23.0" layoutY="307.0" prefHeight="34.0" prefWidth="415.0" promptText="Duration (mins)" />
          <TextField fx:id="priceField" layoutX="25.0" layoutY="368.0" prefHeight="34.0" prefWidth="415.0" promptText="Price" />
          <TextField fx:id="categoryField" layoutX="23.0" layoutY="135.0" prefHeight="34.0" prefWidth="415.0" promptText="Category" />
          <TextArea fx:id="descriptionField" layoutX="23.0" layoutY="195.0" prefHeight="86.0" prefWidth="415.0" promptText="Description" />
          <Button fx:id="btnSave" layoutX="24.0" layoutY="422.0" onAction="#saveChanges" text="Save" />
          <Button fx:id="btnCancel" layoutX="76.0" layoutY="422.0" onAction="#cancel" text="Cancel" />
         <Line endX="323.0" layoutX="115.0" layoutY="45.0" startX="-100.0" stroke="#bcb8b8" />
         <Label layoutX="23.0" layoutY="56.0" text="Service Name" textFill="#bcb8b8">
            <font>
               <Font name="Barlow Condensed Medium" size="15.0" />
            </font>
         </Label>
         <Label layoutX="24.0" layoutY="116.0" text="Category" textFill="#bcb8b8">
            <font>
               <Font name="Barlow Condensed Medium" size="15.0" />
            </font>
         </Label>
         <Label layoutX="23.0" layoutY="176.0" text="Description" textFill="#bcb8b8">
            <font>
               <Font name="Barlow Condensed Medium" size="15.0" />
            </font>
         </Label>
         <Label layoutX="23.0" layoutY="288.0" text="Duration (in minutes)" textFill="#bcb8b8">
            <font>
               <Font name="Barlow Condensed Medium" size="15.0" />
            </font>
         </Label>
         <Label layoutX="24.0" layoutY="349.0" text="Price" textFill="#bcb8b8">
            <font>
               <Font name="Barlow Condensed Medium" size="15.0" />
            </font>
         </Label>
      </children>
   </AnchorPane>
</VBox>
